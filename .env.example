# KIRAKITAH Official Website — environment variable placeholders
# Copy to .env.local for local development.
# Configure the same keys in the Vercel project dashboard for hosted environments.
# Never commit real secrets, API keys, or production credentials.
#
# Full matrix: docs/deployment/PRODUCTION-ENV-MATRIX.md
# Launch docs: docs/deployment/README.md
# Production: NO MOCK PROVIDERS. NEXT_PUBLIC_DATA_SOURCE must be api.
#
# MVP_MANUAL_REVIEW (current launch mode) — REQUIRED on Vercel Production:
#   NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_DATA_SOURCE=api,
#   DATABASE_URL, BLOB_READ_WRITE_TOKEN, REGISTRATION_PII_ENCRYPTION_KEY
# EMAIL / SMS / ADMIN AUTH are DEFERRED for MVP submit (not required to accept applications).
# See docs/deployment/MVP-PRODUCTION-DEPLOYMENT.md

# ---------------------------------------------------------------------------
# PUBLIC VARIABLES (safe to expose to the browser)
# ---------------------------------------------------------------------------

# Public site URL used for canonical links, Open Graph, sitemap, and robots.txt.
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel Preview / Production example:
# NEXT_PUBLIC_SITE_URL=https://your-preview-or-production-domain.vercel.app

# Data source: mock | api
# DEVELOPMENT / CI: mock (default)
# PREVIEW: mock or api
# PRODUCTION (Vercel Production): MUST be api — the app also forces api at runtime
NEXT_PUBLIC_DATA_SOURCE=mock

# ---------------------------------------------------------------------------
# SERVER-ONLY VARIABLES (never use NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------

# Neon PostgreSQL via Vercel Storage integration
# REQUIRED for production registration (application runtime; Neon HTTP driver)
# For `npm run db:migrate`, set the same name in the shell; prefer Neon direct
# (non-pooler) host. `pg` is used by drizzle-kit CLI; runtime stays neon-http.
# DATABASE_URL=postgresql://...

# Vercel Blob — private player photo storage
# REQUIRED for production registration
# BLOB_READ_WRITE_TOKEN=

# AES-256-GCM key for identification numbers (64 hex chars / 32 bytes)
# REQUIRED for production registration
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REGISTRATION_PII_ENCRYPTION_KEY=

# --- Identity verification (manual in production — NOT called on submit) ---
# Automated identity verification: AVAILABLE ARCHITECTURALLY / NOT ENABLED FOR PRODUCTION
# NIN_VERIFICATION_PROVIDER=mock
# NIN_VERIFICATION_API_URL=
# NIN_VERIFICATION_API_KEY=

# --- Email ownership verification ---
# DEVELOPMENT / CI: mock
# PRODUCTION: http (requires URL + API key) — PRODUCTION EMAIL PROVIDER REQUIRED
# Mock is rejected in production (fail closed). Never pretend email was sent.
# EMAIL_VERIFICATION_PROVIDER=mock
# EMAIL_VERIFICATION_API_URL=
# EMAIL_VERIFICATION_API_KEY=

# --- Phone ownership verification ---
# DEVELOPMENT / CI: mock
# PRODUCTION: http (requires URL + API key) — PRODUCTION SMS PROVIDER REQUIRED
# Mock is rejected in production (fail closed). Never pretend SMS was sent.
# PHONE_VERIFICATION_PROVIDER=mock
# PHONE_VERIFICATION_API_URL=
# PHONE_VERIFICATION_API_KEY=

# --- Admin authentication ---
# DEVELOPMENT: mock (no password; role selectable)
# PRODUCTION: database (password against admin_users) — default when unset
# ADMIN_AUTH_PROVIDER=database
# ADMIN_SESSION_SECRET=
# Optional future OIDC:
# ADMIN_AUTH_API_URL=
# ADMIN_AUTH_API_KEY=

# Vercel sets VERCEL_URL / VERCEL_ENV automatically.
# The app falls back to https://VERCEL_URL when NEXT_PUBLIC_SITE_URL is unset.
