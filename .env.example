# KIRAKITAH Official Website — environment variable placeholders
# Copy to .env.local for local development.
# Configure the same keys in the Vercel project dashboard for hosted environments.
# Never commit real secrets, API keys, or production credentials.

# Public site URL used for canonical links, Open Graph, sitemap, and robots.txt.
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel Preview / Production example:
# NEXT_PUBLIC_SITE_URL=https://your-preview-or-production-domain.vercel.app

# Data source: mock | api
# mock — local development and CI (default)
# api — production registration via POST /api/registrations
NEXT_PUBLIC_DATA_SOURCE=mock

# --- Server-only (never use NEXT_PUBLIC_ prefix for secrets) ---
# Neon PostgreSQL via Vercel Storage integration
# DATABASE_URL=postgresql://...

# Vercel Blob — private player photo storage
# BLOB_READ_WRITE_TOKEN=

# AES-256-GCM key for identification numbers (64 hex chars / 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REGISTRATION_PII_ENCRYPTION_KEY=

# --- Verification providers (optional future automation — NOT used on submit) ---
# Production registration uses MANUAL identity review for NIN and passport.
# Automated identity verification: AVAILABLE ARCHITECTURALLY / NOT ENABLED FOR PRODUCTION
# NIN_VERIFICATION_PROVIDER=mock
# NIN_VERIFICATION_API_URL=
# NIN_VERIFICATION_API_KEY=

# Email/phone OTP: mock | none
# EMAIL_VERIFICATION_PROVIDER=mock
# PHONE_VERIFICATION_PROVIDER=mock

# Vercel sets VERCEL_URL automatically during builds and at runtime.
# The app falls back to https://VERCEL_URL when NEXT_PUBLIC_SITE_URL is unset.
